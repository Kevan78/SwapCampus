# =============================================================================
#  Fastlane = the "recipe book" of the pipeline.
#  The same lanes run on a laptop and on GitHub Actions:
#     bundle exec fastlane android test
#     bundle exec fastlane android build_debug
#     bundle exec fastlane android distribute
# =============================================================================
default_platform(:android)

RELEASE_APK = File.expand_path("../androidApp/build/outputs/apk/release/androidApp-release.apk", __dir__)

platform :android do

  desc "Run the unit tests (shared commonTest on the JVM + androidApp)"
  lane :test do
    gradle(tasks: [":shared:testDebugUnitTest", ":androidApp:testDebugUnitTest"])
  end

  desc "Build a debug APK"
  lane :build_debug do
    gradle(task: ":androidApp:assembleDebug")
  end

  desc "Build a release APK (signed with the CI keystore if KEYSTORE_PATH is set)"
  lane :build_release do
    gradle(task: ":androidApp:assembleRelease")
  end

  desc "Test + build release + upload to Firebase App Distribution"
  lane :distribute do
    test
    build_release

    # Release notes: given by the workflow input, otherwise the last 5 commits
    notes = ENV.fetch("RELEASE_NOTES", "").strip
    if notes.empty?
      notes = changelog_from_git_commits(
        commits_count: 5,
        pretty: "- %s (%an)",
        merge_commit_filtering: "exclude_merges"
      )
    end

    apk = File.exist?(RELEASE_APK) ? RELEASE_APK : lane_context[SharedValues::GRADLE_APK_OUTPUT_PATH]

    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      service_credentials_file: ENV.fetch("FIREBASE_SERVICE_ACCOUNT_PATH"),
      android_artifact_type: "APK",
      android_artifact_path: apk,
      groups: ENV.fetch("FIREBASE_TESTER_GROUPS", "classmates"),
      release_notes: notes
    )

    UI.success("SwapCampus build #{ENV.fetch('VERSION_CODE', 'local')} sent to Firebase testers")
  end

  error do |lane, exception|
    UI.error("Lane #{lane} failed: #{exception.message}")
  end
end
